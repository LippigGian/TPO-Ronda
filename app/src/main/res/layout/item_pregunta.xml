<?xml version="1.0" encoding="utf-8"?>
<!-- Punto 4: una pregunta con su respuesta en el detalle de la publicación. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvTextoPregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ronda_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMetaPregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ronda_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvRespuestaPregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:textColor="@color/ronda_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResponderPregunta"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/preguntas_responder"
        android:textAllCaps="false"
        android:textColor="@color/ronda_primary"
        android:visibility="gone"
        app:cornerRadius="12dp" />
</LinearLayout>
