<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

<!--    <TextView-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="Hello World!"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent" />-->

    <TextView
        android:id="@+id/tvTituloPublicacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="Título de ejemplo"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
<!--Textos como "titulo ejemplo o $0 son de previsualizacion, luego en java los reemplazamos por los valores reales-->
    <TextView
        android:id="@+id/tvPrecioPublicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="$ 0"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/tvTituloPublicacion"
        app:layout_constraintTop_toBottomOf="@id/tvTituloPublicacion" />

    <TextView
        android:id="@+id/tvEstadoPublicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Estado"
        app:layout_constraintStart_toStartOf="@id/tvTituloPublicacion"
        app:layout_constraintTop_toBottomOf="@id/tvPrecioPublicacion" />

    <TextView
        android:id="@+id/tvZonaPublicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Zona"
        app:layout_constraintStart_toStartOf="@id/tvTituloPublicacion"
        app:layout_constraintTop_toBottomOf="@id/tvEstadoPublicacion" />

</androidx.constraintlayout.widget.ConstraintLayout>