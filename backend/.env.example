# Configuracion LOCAL. Copiar como .env y elegir una contrasena antes de iniciar.
# Usar letras y numeros para que el archivo sea compatible con Compose y Java Properties.
DB_NAME=ronda
DB_USER=ronda
DB_PASSWORD=
DB_PORT=5432
SERVER_PORT=8080
# Duración de la sesión JWT en segundos. 3600 = una hora.
JWT_EXPIRATION_SECONDS=3600
# Interfaz web local para ver los emails OTP enviados durante el desarrollo.
MAILPIT_WEB_PORT=8025
